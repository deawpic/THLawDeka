# Thai Legal Intelligence Advisor - Environment Template
# คัดลอกไฟล์นี้เป็น .env แล้วกรอก API Key จริงของท่าน

# SLegalTools API Key (https://api.slegaltools.digital/dashboard)
DEKA_API_KEY=your_slegaltools_api_key_here

# FourCorners Law API Key (https://app.fourcorners.law/settings?tab=mcp)
FC_API_KEY=your_fourcorners_api_key_here

# Thai Legal Tech API Key (https://legaltech.in.th/dashboard/api-keys)
TL_API_KEY=your_thailegal_api_key_here
