{
  "mcpServers": {
    "fourcorners-tlex": {
      "type": "http",
      "url": "https://app.fourcorners.law/api/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_FOURCORNERS_API_KEY",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
      }
    },
    "slegaltools-legal-v2": {
      "command": "python",
      "args": [
        "path/to/slegaltools_deka_mcp_bridge.py"
      ],
      "env": {
        "SLEGALTOOLS_BASE_URL": "https://api.slegaltools.digital",
        "SLEGALTOOLS_API_KEY": "YOUR_SLEGALTOOLS_API_KEY"
      }
    },
    "thai-legal": {
      "type": "http",
      "url": "https://mcp.legaltech.in.th/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_THAI_LEGAL_API_KEY"
      }
    }
  }
}
